# Console on the native USB Serial/JTAG port: the same port the Mac reads kvm_proto
# from. src/serial.cpp installs its driver and prefixes every log line with "# ".
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# Plain log lines (no ANSI colour codes) for the Mac's host.log.
CONFIG_LOG_COLORS=n
# The ROM and bootloader print unprefixed lines at power-up; keep the bootloader's to
# warnings. The Mac daemon ignores any line that isn't "# " or kvm_proto.
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# 4MB flash. Partition table in partitions.csv (two ~1.9MB OTA slots).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y

# OTA: a new image boots once in pending-verify and rolls back unless it marks itself
# valid (ota_pull::confirm_boot, once Wi-Fi has an IP).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
