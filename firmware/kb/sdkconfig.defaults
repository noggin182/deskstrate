# Console on the native USB Serial/JTAG port.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# 4MB flash. Partition table in partitions.csv (two ~1.9MB OTA slots).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y

# OTA: a new image boots once in pending-verify and rolls back unless it marks itself
# valid (ota_pull::confirm_boot, once Wi-Fi has an IP).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# HTTPS for the web UI (components/web_tls).
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
