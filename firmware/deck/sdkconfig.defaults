CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_LV_FONT_MONTSERRAT_22=y

# 4MB embedded flash (confirmed with esptool read_mac on the Feather).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# Partition table in partitions.csv (two ~1.9MB OTA slots).
CONFIG_PARTITION_TABLE_CUSTOM=y

# OTA: a new image boots once in pending-verify and rolls back unless it marks itself
# valid (ota_pull::confirm_boot, once the UI is up and Wi-Fi has an IP).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Web page with the live screen mirror (web.cpp, mirror.cpp): WebSockets, and HTTPS
# (components/web_tls) like the core and kb.
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
# web_tls makes the board's CSR (off by default in ESP-IDF).
CONFIG_MBEDTLS_X509_CREATE_C=y
CONFIG_MBEDTLS_X509_CSR_WRITE_C=y
