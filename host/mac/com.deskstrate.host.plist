<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Mac's Deskstrate daemon, in the user's GUI session. Installed by `make install`. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.deskstrate.host</string>
    <key>ProgramArguments</key>
    <array>
        <string>@HOME@/Library/Application Support/Deskstrate/deskstrate-host</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>@HOME@/Library/Logs/Deskstrate/host.log</string>
    <key>StandardErrorPath</key>
    <string>@HOME@/Library/Logs/Deskstrate/host.log</string>
</dict>
</plist>
